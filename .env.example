# MongoDB connection string (Atlas or a local replica set — transactions require a replica set)
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/learnhub?retryWrites=true&w=majority"

# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/) — optional but provider is wired up
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
