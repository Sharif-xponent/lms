// Prisma schema — LearnHub LMS with Quiz Support (One-to-Many)

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  TEXT
  VIDEO
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(STUDENT)

  accounts Account[]
  sessions Session[]

  // LearnHub relations
  courses      Course[]
  enrollments  Enrollment[]
  reviews      Review[]
  quizAttempts QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== LEARNHUB MODELS ==========

model Course {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  coverImage  String?
  category    String
  level       String
  price       Float
  status      CourseStatus @default(DRAFT)

  instructorId String       @db.ObjectId
  instructor   User         @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([level])
  @@index([instructorId])
}

model Section {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int

  courseId String   @db.ObjectId
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  quizzes  Quiz[] // One-to-many: section can have multiple quizzes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, order])
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String?
  videoUrl    String?
  attachments String[]
  type        LessonType @default(TEXT)
  order       Int
  isPreview   Boolean    @default(false)

  sectionId String  @db.ObjectId
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quizzes   Quiz[] // One-to-many: lesson can have multiple quizzes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, order])
}

model Quiz {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  description     String?
  timeLimit       Int?
  passingScore    Int     @default(70)
  attemptsAllowed Int     @default(1) // -1 for unlimited
  order           Int     @default(0) // For ordering quizzes

  // Polymorphic relations: can belong to either Section or Lesson (one-to-many)
  sectionId String? @db.ObjectId
  lessonId  String? @db.ObjectId

  section   Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([lessonId])
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  text          String
  options       String[]
  correctAnswer Int
  points        Int      @default(1)
  explanation   String?
  order         Int      @default(0)

  quizId String @db.ObjectId
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model QuizAttempt {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  score       Int
  totalPoints Int
  percentage  Float
  passed      Boolean
  answers     Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quizId    String @db.ObjectId
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([studentId])
}

model Enrollment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  progress       Int      @default(0)
  completed      Boolean  @default(false)
  enrolledAt     DateTime @default(now())
  lastAccessedAt DateTime @updatedAt

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String @db.ObjectId
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedItems Json?

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Review {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  rating  Int
  comment String?

  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String @db.ObjectId
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId, rating])
}
