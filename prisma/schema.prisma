// Prisma schema — LearnHub LMS (Minimal for Modules 1 & 2)
// Extended from the provided auth starter

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonType {
  TEXT
  VIDEO
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(STUDENT)

  accounts Account[]
  sessions Session[]

  // LearnHub relations
  courses     Course[]     // Courses authored (instructor)
  enrollments Enrollment[] // Courses enrolled (student)
  reviews     Review[]     // Reviews written (student)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== LEARNHUB MODELS (Modules 1 & 2) ==========

model Course {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  coverImage  String?      // URL to cover image
  category    String       // e.g., "Programming", "Design", "Business"
  level       String       // "Beginner", "Intermediate", "Advanced"
  price       Float        // 0 = free, >0 = paid
  status      CourseStatus @default(DRAFT)
  
  // Relations
  instructorId String  @db.ObjectId
  instructor   User    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sections     Section[]
  enrollments  Enrollment[]
  reviews      Review[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Indexes for catalog search/filter
  @@index([status])
  @@index([category])
  @@index([level])
  @@index([instructorId])
}

model Section {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  order       Int      // For drag-and-drop ordering
  
  // Relations
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([courseId, order])
}

model Lesson {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String?    // Rich text content
  videoUrl    String?    // URL to video
  attachments String[]   // Array of attachment URLs
  type        LessonType @default(TEXT)
  order       Int        // For ordering within section
  isPreview   Boolean    @default(false) // Free preview for non-enrolled students
  
  // Relations
  sectionId   String     @db.ObjectId
  section     Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quiz        Quiz?      // Optional quiz attached to lesson
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([sectionId, order])
}

model Quiz {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  passingScore Int      @default(70) // Percentage required to pass
  
  // Relations
  lessonId    String    @unique @db.ObjectId // One-to-one with lesson
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   Question[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Question {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  text        String
  options     String[] // Array of option texts (for multiple choice)
  correctAnswer Int    // Index of correct option (0-based)
  points      Int      @default(1)
  
  // Relations
  quizId      String   @db.ObjectId
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([quizId])
}

model Enrollment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  progress    Int      @default(0) // Percentage of course completed
  completed   Boolean  @default(false)
  enrolledAt  DateTime @default(now())
  
  // Relations
  studentId   String   @db.ObjectId
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Quiz results can be stored separately if needed
  
  @@unique([studentId, courseId]) // Prevent duplicate enrollments
  @@index([studentId])
  @@index([courseId])
}

model Review {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  rating      Int      // 1-5 stars
  comment     String?
  
  // Relations
  studentId   String   @db.ObjectId
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String   @db.ObjectId
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([studentId, courseId]) // One review per student per course
  @@index([courseId, rating])
}